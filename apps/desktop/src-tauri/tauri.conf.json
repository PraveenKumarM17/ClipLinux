{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLinux",
  "version": "0.1.0",
  "identifier": "io.clipl.ClipLinux",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "palette",
        "title": "ClipLinux",
        "width": 440,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
